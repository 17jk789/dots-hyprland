#!/usr/bin/env bash
# Einstiegspunkt für die Einrichtung von JK Gray Linux
# Überarbeitet für einen vorhersehbaren Kontrollfluss, einen sichereren Umgang mit Berechtigungen und
# eine konsistente Terminalausgabe. Kompatibel mit den bestehenden sdata-Modulen.

# Die strengen Shell-Optionen werden aktiviert, nachdem die alten Projektbibliotheken geladen wurden.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    printf '[ ERROR ] Bash 4.4 or newer is required.\n' >&2
    exit 1
fi

###############################################################################
# Repository-Pfade und vorhandene Projektbibliotheken
###############################################################################

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    resolved_source="$(readlink -f -- "$SCRIPT_SOURCE" 2>/dev/null || true)"
    [[ -n "$resolved_source" ]] && SCRIPT_SOURCE="$resolved_source"
fi

if ! SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_SOURCE")" 2>/dev/null && pwd -P)"; then
    printf '[ ERROR ] Could not determine the script directory.\n' >&2
    exit 1
fi
REPO_ROOT="$SCRIPT_DIR"
if ! cd -- "$REPO_ROOT"; then
    printf '[ ERROR ] Could not enter the repository directory: %s\n' "$REPO_ROOT" >&2
    exit 1
fi

for library in \
    "$REPO_ROOT/sdata/lib/environment-variables.sh" \
    "$REPO_ROOT/sdata/lib/functions.sh" \
    "$REPO_ROOT/sdata/lib/package-installers.sh" \
    "$REPO_ROOT/sdata/lib/dist-determine.sh"; do
    if [[ ! -r "$library" ]]; then
        printf '[ ERROR ] Required library not found: %s\n' "$library" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    if ! source "$library"; then
        printf '[ ERROR ] Failed to load library: %s\n' "$library" >&2
        exit 1
    fi
done

# `nounset` sollte bewusst nicht global aktiviert werden: Ältere sdata-Module verwenden möglicherweise
# optionale Variablen, die nur durch den jeweils ausgewählten Unterbefehl initialisiert werden.
set -Ee -o pipefail

###############################################################################
# Vertrag über die Präsentation am Terminal
###############################################################################

UI_WIDTH=60
UI_INNER_WIDTH=$((UI_WIDTH - 2))
UI_COLOR_RESET=''
UI_COLOR_GREEN=''
UI_COLOR_CYAN=''
UI_COLOR_YELLOW=''
UI_COLOR_RED=''
UI_COLOR_FAINT=''

ui_init() {
    if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
        UI_COLOR_RESET="$(tput sgr0 2>/dev/null || true)"
        UI_COLOR_GREEN="$(tput setaf 2 2>/dev/null || true)"
        UI_COLOR_CYAN="$(tput setaf 6 2>/dev/null || true)"
        UI_COLOR_YELLOW="$(tput setaf 3 2>/dev/null || true)"
        UI_COLOR_RED="$(tput setaf 1 2>/dev/null || true)"
        UI_COLOR_FAINT="$(tput dim 2>/dev/null || true)"
    fi
}

ui_status() {
    local kind="${1^^}"
    shift
    local color=''

    case "$kind" in
        OK)    color="$UI_COLOR_GREEN" ;;
        INFO|WAIT) color="$UI_COLOR_CYAN" ;;
        WARN|SKIP) color="$UI_COLOR_YELLOW" ;;
        ERROR) color="$UI_COLOR_RED" ;;
        DEBUG) color="$UI_COLOR_FAINT" ;;
        *)
            kind='INFO'
            color="$UI_COLOR_CYAN"
            ;;
    esac

    printf '%s[ %-5s ]%s %s\n' "$color" "$kind" "$UI_COLOR_RESET" "$*"
}

ui_frame() {
    local heading="$1"
    local line
    local left right

    if ((${#heading} > UI_INNER_WIDTH)); then
        heading="${heading:0:UI_INNER_WIDTH}"
    fi

    left=$(((UI_INNER_WIDTH - ${#heading}) / 2))
    right=$((UI_INNER_WIDTH - ${#heading} - left))
    printf -v line '%*s' "$UI_INNER_WIDTH" ''
    line="${line// /═}"

    printf '\n╔%s╗\n' "$line"
    printf '║%*s%s%*s║\n' "$left" '' "$heading" "$right" ''
    printf '╚%s╝\n\n' "$line"
}

ui_section() {
    local heading="$1"
    local line
    local left right

    if ((${#heading} > UI_INNER_WIDTH)); then
        heading="${heading:0:UI_INNER_WIDTH}"
    fi

    left=$(((UI_INNER_WIDTH - ${#heading}) / 2))
    right=$((UI_INNER_WIDTH - ${#heading} - left))
    printf -v line '%*s' "$UI_INNER_WIDTH" ''
    line="${line// /─}"

    printf '\n┌%s┐\n' "$line"
    printf '│%*s%s%*s│\n' "$left" '' "$heading" "$right" ''
    printf '└%s┘\n\n' "$line"
}

ui_subsection() {
    printf '\n── %s ──\n' "$*"
}

ui_command() {
    printf '$'
    printf ' %q' "$@"
    printf '\n'
}

ui_init

on_error() {
    local exit_code="$1"
    local failed_command="$2"
    local line_number="$3"

    trap - ERR
    ui_status ERROR "Command failed with exit code ${exit_code} at line ${line_number}."
    ui_status DEBUG "Command: ${failed_command}"
    exit "$exit_code"
}
trap 'on_error "$?" "$BASH_COMMAND" "$LINENO"' ERR

###############################################################################
# Allgemeine Hilfsfunktionen
###############################################################################

