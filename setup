}

show_security_notice() {
    ui_section 'Authorized use and legal notice'
    printf '%s\n' \
        'JK Gray Linux is intended for lawful administration, education,' \
        'research, auditing and authorized security testing.' \
        '' \
        'Use its tools only on systems you own or are expressly authorized' \
        'to assess. Permission must cover the relevant targets, methods,' \
        'time period and data handling. Do not exceed that scope.' \
        '' \
        'Stop if authorization is absent, withdrawn or unclear. Do not' \
        'access, alter, disrupt, monitor or disclose third-party systems' \
        'or data without a valid legal basis and required permission.' \
        '' \
        'You are responsible for compliance with applicable laws, contracts,' \
        'policies and third-party rights. This software grants no access' \
        'rights or testing authorization and is provided without warranty' \
        'to the extent permitted by law. Nothing excludes liability that' \
        'cannot lawfully be excluded.'
    printf '\n'
}

showhelp_global() {
    ui_frame 'JK Gray Linux Setup'
    printf '%s\n' 'Manage the illogical-impulse / JK Gray Linux setup.'
    printf '\n'
    ui_section 'Usage'
    printf '  %s <subcommand> [OPTIONS...]\n\n' "$0"
    printf '%s\n' \
        'Subcommands:' \
        '  install        Run the complete setup workflow.' \
        '  install-deps   Run dependency installation.' \
        '  install-setups Run permission and service setup.' \
        '  install-files  Copy configuration files.' \
        '  resetfirstrun  Reset first-run state.' \
        '  uninstall      Uninstall illogical-impulse.' \
        '  exp-update     Experimental update without full reinstall.' \
        '  exp-merge      Experimental upstream merge using git rebase.' \
        '  virtmon        Create virtual monitors for development.' \
        '  checkdeps      Check Arch package availability.' \
        '  help           Show this help.'
    printf '\n'
    printf 'For subcommand-specific help, run: %s <subcommand> -h\n' "$0"
    printf 'Documentation: https://ii.clsty.link\n'
}

require_command() {
    local command_name="$1"
    local purpose="${2:-required operation}"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        ui_status ERROR "Required command '$command_name' is unavailable (${purpose})."
        return 1
    fi
}

run_root() {
    if ((EUID == 0)); then
        "$@"
        return
    fi

    require_command sudo 'privileged system changes' || return 1
    sudo "$@"
}

pacman_install() {
    if (($# == 0)); then
        ui_status ERROR 'pacman_install received no package names.'
        return 2
    fi

    require_command pacman 'Arch package installation' || return 1
    ui_subsection 'Installing packages'
    ui_status INFO 'Refreshing package databases and applying a full system upgrade (Arch-supported update path).'
    if ((EUID == 0)); then
        ui_command pacman -Syu --needed "$@"
    else
        ui_command sudo pacman -Syu --needed "$@"
    fi

    if ! run_root pacman -Syu --needed "$@"; then
        ui_status ERROR "Package installation failed: $*"
        return 1
    fi

    ui_status OK "Packages installed or already present: $*"
}

ask_yes_no() {
    local question="$1"
    local default_answer="${2:-no}"
    local reply
    local normalized

    while true; do
        if [[ "$default_answer" == 'yes' ]]; then
            if ! IFS= read -r -p "? ${question} [Y/n]: " reply; then
                ui_status WARN 'Input stream closed; treating the answer as no.'
                return 1
            fi
        else
            if ! IFS= read -r -p "? ${question} [y/N]: " reply; then
                ui_status WARN 'Input stream closed; treating the answer as no.'
                return 1
            fi
        fi

        normalized="${reply,,}"
        case "$normalized" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            '')
                [[ "$default_answer" == 'yes' ]] && return 0
                return 1
                ;;
            *)
                ui_status ERROR 'Please enter y or n.'
                ;;
        esac
    done
}

read_choice() {
    local prompt="$1"
    local destination_variable="$2"
    local value

    if ! IFS= read -r -p "? ${prompt}: " value; then
        ui_status ERROR 'Could not read input. No selection was made.'
        return 1
    fi

    printf -v "$destination_variable" '%s' "$value"
}

check_internet() {
    require_command curl 'network connectivity check' || return 1
    ui_status WAIT 'Checking Internet connectivity...'

    if curl --silent --show-error --fail \
        --connect-timeout 8 --max-time 15 \
        https://archlinux.org/ -o /dev/null; then
        ui_status OK 'Internet connectivity is available.'
    else
        ui_status ERROR 'Internet connectivity check failed.'
        return 1
    fi
}

check_systemd() {
    require_command systemctl 'service management' || return 1
    if [[ ! -d /run/systemd/system ]]; then
        ui_status ERROR 'This system is not currently running systemd.'
        return 1
    fi
}

is_arch_linux() {
    local distro_id=''
    local distro_like=''

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        distro_id="${ID:-}"
        distro_like="${ID_LIKE:-}"
    fi

    [[ -f /etc/arch-release || -f /etc/cachyos-release ]] && return 0
    [[ "$distro_id" == 'arch' || "$distro_id" == 'cachyos' ]] && return 0
    [[ " $distro_like " == *' arch '* ]]
}

is_archiso() {
    [[ -d /run/archiso ]]
}

is_existing_linux_installation() {
    [[ -f /etc/os-release && -d /run/systemd/system ]] && ! is_archiso
}

confirm_non_arch() {
    ui_section 'Distribution compatibility'
    ui_status WARN 'This installer is primarily designed for Arch Linux and CachyOS.'
    ui_status WARN 'On other distributions, package and service operations may not work.'
    printf 'Arch-specific operating-system installers will be disabled.\n\n'

    local acknowledgement
    if ! IFS= read -r -p '? Type exactly "I understand" to continue: ' acknowledgement; then
        ui_status ERROR 'Could not read confirmation. Installation cancelled.'
        return 1
    fi

    if [[ "$acknowledgement" != 'I understand' ]]; then
        ui_status ERROR 'Confirmation did not match. Installation cancelled.'
        return 1
    fi

    ui_status OK 'Compatibility acknowledgement accepted.'
}

###############################################################################
# Konfiguration des Datenschutzes im Netzwerk
###############################################################################

privacy_info() {
    ui_status INFO "$1"
}

privacy_error() {
    ui_status ERROR "$1"
    return 1
}

privacy_start_service() {
    local service_name="$1"

    if ! run_root systemctl enable --now "$service_name"; then
        privacy_error "Could not enable and start ${service_name}."
        return 1
    fi

    if ! systemctl is-active --quiet "$service_name"; then
        privacy_error "Service ${service_name} is not active after startup."
        return 1
    fi

    ui_status OK "Service ${service_name} is active."
}

mullvad_login_if_needed() {
    local account_number=''

    ui_subsection 'Mullvad account'

    if mullvad account get >/dev/null 2>&1; then
        ui_status OK 'A Mullvad account is already configured.'
        return 0
    fi

    ui_status INFO 'A Mullvad account number is required for this mode.'
    ui_status INFO 'The account number is read without terminal echo and is not written to a file.'

    while true; do
        if ! IFS= read -r -s -p '? Mullvad account number (16 digits): ' account_number; then
            printf '\n'
            privacy_error 'Could not read the Mullvad account number.'
            return 1
        fi
        printf '\n'

        account_number="${account_number//[[:space:]]/}"
        if [[ "$account_number" =~ ^[0-9]{16}$ ]]; then
            break
        fi

        ui_status ERROR 'The account number must contain exactly 16 digits.'
        account_number=''
    done

    ui_status WAIT 'Logging in to Mullvad...'
    # Die Befehlszeilenschnittstelle (CLI) akzeptiert die Kontonummer als Argument. Das bedeutet, dass sie
    # während der Ausführung des Befehls möglicherweise kurzzeitig in der lokalen Prozessliste sichtbar ist.
    if ! mullvad account login "$account_number"; then
        unset account_number
        privacy_error 'Mullvad login failed. Check the account number and try again.'
        return 1
    fi
    unset account_number

    if ! mullvad account get >/dev/null 2>&1; then
        privacy_error 'Mullvad login could not be verified.'
        return 1
    fi

    ui_status OK 'Mullvad account login verified.'
}

mullvad_network_check() {
    local response=''

    response="$(curl --silent --show-error --fail \
        --connect-timeout 10 --max-time 25 \
        https://am.i.mullvad.net/connected 2>/dev/null || true)"

    if grep -qi 'You are connected to Mullvad' <<<"$response"; then
        ui_status OK 'External connectivity check confirms Mullvad.'
        return 0
    fi

    ui_status ERROR 'The Mullvad external connectivity check did not confirm the VPN.'
    return 1
}

mullvad_connect_and_verify() {
    local status_output=''
    local connected=false

    ui_subsection 'Mullvad VPN'

    privacy_info 'Enabling Mullvad auto-connect.'
    if ! mullvad auto-connect set on; then
        privacy_error 'Could not enable Mullvad auto-connect.'
        return 1
    fi
    ui_status OK 'Mullvad auto-connect enabled.'

    privacy_info 'Enabling Mullvad Lockdown Mode (kill switch).'
    if ! mullvad lockdown-mode set on; then
        privacy_error 'Could not enable Mullvad Lockdown Mode.'
        return 1
    fi
    ui_status OK 'Mullvad Lockdown Mode enabled.'

    privacy_info 'Requesting VPN connection.'
    if ! mullvad connect; then
        privacy_error 'Mullvad connection request failed.'
        return 1
    fi

    ui_status WAIT 'Waiting for the Mullvad tunnel (maximum 60 seconds)...'
    for _ in {1..60}; do
        status_output="$(LC_ALL=C mullvad status 2>/dev/null || true)"
        if grep -Eqi '(^|[[:space:]])Connected([[:space:]]|$)|Connected to' <<<"$status_output"; then
            connected=true
            break
        fi
        sleep 1
    done

    if [[ "$connected" != true ]]; then
        ui_status ERROR 'Mullvad did not report a connected tunnel.'
        mullvad status -v || true
        return 1
    fi

    ui_status OK 'Mullvad tunnel reports connected.'
    ui_status WAIT 'Verifying the public connection through Mullvad...'
    mullvad_network_check
}

tor_proxy_ready() {
    (exec 3<>/dev/tcp/127.0.0.1/9050) 2>/dev/null
}

tor_network_check() {
    local response=''

    response="$(curl --silent --show-error --fail \
        --connect-timeout 10 --max-time 45 \
        --proxy socks5h://127.0.0.1:9050 \
        https://check.torproject.org/api/ip 2>/dev/null || true)"

    if grep -Eq '"IsTor"[[:space:]]*:[[:space:]]*true' <<<"$response"; then
        ui_status OK 'External connectivity check confirms Tor.'
        return 0
    fi

    ui_status ERROR 'Tor is running, but the external check did not confirm a Tor exit node.'
    return 1
}

tor_start_and_verify() {
    ui_subsection 'Tor'

    privacy_info 'Enabling and starting tor.service.'
    privacy_start_service tor.service || return 1

    ui_status WAIT 'Waiting for the SOCKS5 listener on 127.0.0.1:9050 (maximum 30 seconds)...'
    local ready=false
    for _ in {1..30}; do
        if tor_proxy_ready; then
            ready=true
            break
        fi
        sleep 1
    done

    if [[ "$ready" != true ]]; then
        ui_status ERROR 'Tor SOCKS5 listener is not available on 127.0.0.1:9050.'
        ui_status INFO 'Inspect logs with: journalctl -u tor.service -n 50 --no-pager'
        return 1
    fi

    ui_status OK 'Tor SOCKS5 listener is available.'
    ui_status WAIT 'Verifying Tor network connectivity...'
    tor_network_check
}

choose_privacy_mode() {
    local choice=''

    if [[ "$IS_ARCH_LINUX" != true ]]; then
        PRIVACY_MODE='direct'
        export PRIVACY_MODE
        ui_status SKIP 'Privacy service installation is only enabled on Arch Linux and CachyOS.'
        ui_status INFO 'Using direct connection for this run.'
        return 0
    fi

    ui_section 'Network privacy configuration'
    printf 'Choose which network service should be configured on this running system.\n\n'
    printf '  1) Tor\n'
    printf '  2) Mullvad VPN\n'
    printf '  3) Mullvad VPN + Tor\n'
    printf '  4) Direct connection\n\n'

    while true; do
        read_choice 'Select a mode [1-4]' choice || return 1
        case "$choice" in
            1) PRIVACY_MODE='tor'; break ;;
            2) PRIVACY_MODE='mullvad'; break ;;
            3) PRIVACY_MODE='mullvad+tor'; break ;;
            4) PRIVACY_MODE='direct'; break ;;
            *)
                ui_status ERROR 'Invalid privacy selection.'
                ui_status INFO 'Choose 1, 2, 3 or 4.'
                ;;
        esac
    done

    export PRIVACY_MODE
    ui_status OK "Privacy preference selected: ${PRIVACY_MODE}."
}

configure_privacy() {
    choose_privacy_mode || return 1

    ui_section 'Privacy configuration summary'
    case "$PRIVACY_MODE" in
        tor)        printf 'Selected mode: Tor\n' ;;
        mullvad)    printf 'Selected mode: Mullvad VPN\n' ;;
        mullvad+tor) printf 'Selected mode: Mullvad VPN followed by Tor\n' ;;
        direct)     printf 'Selected mode: Direct connection\n' ;;
        *)          privacy_error "Unknown privacy mode: ${PRIVACY_MODE}"; return 1 ;;
    esac
    printf '\n'
    ui_status INFO 'The selected mode configures services on the currently running system; it is not saved as a separate preference.'
    ui_status WARN 'It does not guarantee that every application uses Tor or the VPN.'
    ui_status WARN 'A privacy service does not grant authorization to access third-party systems.'

    if [[ "$PRIVACY_MODE" == 'direct' ]]; then
        ui_status SKIP 'No Tor or Mullvad package or service will be installed.'
        return 0
    fi

    if [[ "${RUNNING_FROM_ARCHISO:-no}" == 'yes' ]]; then
        ui_status WARN 'Running from Arch ISO: these service changes affect the live environment only.'
        ui_status WARN 'They are not automatically copied into the newly installed operating system.'
    fi

    if [[ "$PRIVACY_MODE" == 'mullvad' || "$PRIVACY_MODE" == 'mullvad+tor' ]]; then
        ui_status WARN 'Mullvad Lockdown Mode can block Internet traffic until the VPN reconnects.'
        ui_status WARN 'Auto-connect and Lockdown Mode remain enabled after this script exits.'
    fi

    require_command pacman 'privacy package installation' || return 1
    check_systemd || return 1

    # Für die Überprüfung der Erreichbarkeit externer Ziele wird `curl` benötigt. Installieren Sie es, bevor
    # Sie diese Überprüfungen auf minimal installierten Arch-Systemen durchführen, auf denen es nicht vorhanden ist.
    if ! command -v curl >/dev/null 2>&1; then
        pacman_install curl || return 1
    fi
    require_command curl 'privacy connectivity verification' || return 1
    check_internet || return 1

    case "$PRIVACY_MODE" in
        tor)
            pacman_install tor curl || return 1
            tor_start_and_verify || return 1
            ;;
        mullvad)
            # Das aktuelle Arch-Paket heißt „mullvad-vpn“.
            pacman_install mullvad-vpn curl || return 1
            require_command mullvad 'Mullvad command-line client' || return 1
            privacy_start_service mullvad-daemon.service || return 1
            mullvad_login_if_needed || return 1
            mullvad_connect_and_verify || return 1
            ;;
        mullvad+tor)
            pacman_install mullvad-vpn tor curl || return 1
            require_command mullvad 'Mullvad command-line client' || return 1
            privacy_start_service mullvad-daemon.service || return 1
            mullvad_login_if_needed || return 1
            # Richten Sie das VPN ein und überprüfen Sie die Verbindung, bevor Sie Tor starten.
            mullvad_connect_and_verify || return 1
            tor_start_and_verify || return 1
            ;;
    esac

    ui_section 'Privacy service verification'
    case "$PRIVACY_MODE" in
        tor)
            if systemctl is-active --quiet tor.service && tor_proxy_ready && tor_network_check; then
                ui_status OK 'Tor daemon, SOCKS5 listener and Tor network are verified.'
            else
                ui_status ERROR 'Tor final verification failed.'
                return 1
            fi
            ;;
        mullvad)
            if systemctl is-active --quiet mullvad-daemon.service \
                && mullvad account get >/dev/null 2>&1 \
                && mullvad_network_check; then
                ui_status OK 'Mullvad daemon, account and external connection are verified.'
            else
                ui_status ERROR 'Mullvad final verification failed.'
                return 1
            fi
            ;;
        mullvad+tor)
            if systemctl is-active --quiet mullvad-daemon.service \
                && systemctl is-active --quiet tor.service \
                && mullvad account get >/dev/null 2>&1 \
                && mullvad_network_check \
                && tor_proxy_ready \
                && tor_network_check; then
                ui_status OK 'Mullvad and Tor services and external connections are verified.'
            else
                ui_status ERROR 'Mullvad + Tor final verification failed.'
                return 1
            fi
            ;;
    esac

    ui_status OK 'Privacy service configuration completed.'
}

###############################################################################
# Erkennung und Ausführung des Betriebssystem-Installationsprogramms
###############################################################################

 detect_installers() {
    if [[ -f "$REPO_ROOT/jk-arch-installer/arch-installer.py" ]]; then
        JK_GRAY_INSTALLER_AVAILABLE='yes'
    else
        JK_GRAY_INSTALLER_AVAILABLE='no'
    fi

    if [[ -r /etc/pacman.conf ]] && grep -qE '^[[:space:]]*\[blackarch\][[:space:]]*$' /etc/pacman.conf; then
        BLACKARCH_AVAILABLE='yes'
    else
        BLACKARCH_AVAILABLE='no'
    fi

    if command -v blackarch-install >/dev/null 2>&1; then
        BLACKARCH_INSTALLER_AVAILABLE='yes'
    else
        BLACKARCH_INSTALLER_AVAILABLE='no'
    fi

    if command -v archinstall >/dev/null 2>&1; then
        ARCHINSTALL_AVAILABLE='yes'
    else
        ARCHINSTALL_AVAILABLE='no'
    fi

    CACHYOS_INSTALLER_REPOSITORY="${CACHYOS_INSTALLER_REPOSITORY:-https://github.com/CachyOS/New-Cli-Installer.git}"
    CACHYOS_INSTALLER_DIR="$REPO_ROOT/cachyos-new-installer"

    if [[ -d "$CACHYOS_INSTALLER_DIR" && -f "$CACHYOS_INSTALLER_DIR/CMakeLists.txt" ]]; then
        CACHYOS_INSTALLER_AVAILABLE='yes'
    else
        CACHYOS_INSTALLER_AVAILABLE='no'
    fi
}

set_install_recommendation() {
    if [[ "$EXISTING_LINUX_INSTALLATION" == 'yes' ]]; then
        INSTALL_RECOMMENDATION='5'
    elif [[ "$RUNNING_FROM_ARCHISO" == 'yes' && "$JK_GRAY_INSTALLER_AVAILABLE" == 'yes' ]]; then
        INSTALL_RECOMMENDATION='3'
    elif [[ "$RUNNING_FROM_ARCHISO" == 'yes' ]]; then
        INSTALL_RECOMMENDATION='1'
    elif [[ "$JK_GRAY_INSTALLER_AVAILABLE" == 'yes' ]]; then
        INSTALL_RECOMMENDATION='3'
    else
        INSTALL_RECOMMENDATION='5'
    fi
}

show_installation_options() {
    ui_frame 'Installation options'

    if [[ "$RUNNING_FROM_ARCHISO" == 'yes' ]]; then
        ui_status INFO 'Running from Arch Linux installation media.'
    elif [[ "$EXISTING_LINUX_INSTALLATION" == 'yes' ]]; then
        ui_status INFO 'An existing Linux installation was detected.'
    else
        ui_status WARN 'No existing Linux installation or Arch ISO was detected.'
    fi

    printf '\n'
    printf '  1) Archinstall\n'
    printf '     Official guided Arch Linux installer.\n\n'
    printf '  2) BlackArch Installer [EXPERIMENTAL]\n'
    printf '     Official BlackArch installer (repository package or GitHub source).\n\n'
    printf '  3) JK Gray Linux Installer [EXPERIMENTAL]\n'
    printf '     Arch Linux + Hyprland + JK Gray Linux base configuration.\n\n'
    printf '  4) CachyOS New CLI Installer [EXPERIMENTAL]\n'
    printf '     Build and run the CachyOS CLI installer from its source repository.\n\n'
    printf '  5) Keep current system configuration\n'
    if [[ "$INSTALL_RECOMMENDATION" == '5' ]]; then
        printf '     [RECOMMENDED]\n'
    fi
    printf '     Do not launch another operating-system installer.\n\n'

    printf 'Detected availability:\n'
    printf '  JK Gray installer    : %s\n' "$JK_GRAY_INSTALLER_AVAILABLE"
    printf '  BlackArch repository : %s\n' "$BLACKARCH_AVAILABLE"
    printf '  BlackArch installer  : %s\n' "$BLACKARCH_INSTALLER_AVAILABLE"
    printf '  Archinstall          : %s\n' "$ARCHINSTALL_AVAILABLE"
    printf '  CachyOS installer    : %s\n' "$CACHYOS_INSTALLER_AVAILABLE"
    printf '  Existing Linux       : %s\n' "$EXISTING_LINUX_INSTALLATION"
    printf '  Arch ISO             : %s\n' "$RUNNING_FROM_ARCHISO"
    printf '\n'
}

prepare_ntp() {
    if command -v timedatectl >/dev/null 2>&1; then
        if run_root timedatectl set-ntp true; then
            ui_status OK 'Network time synchronization enabled.'
        else
            ui_status WARN 'Could not enable network time synchronization.'
        fi
    else
        ui_status WARN 'timedatectl is unavailable; skipping NTP setup.'
    fi
}

request_reboot_after_installer() {
    ui_status OK 'The selected operating-system installer completed successfully.'
    if ask_yes_no 'Reboot now?' yes; then
        ui_status WAIT 'Rebooting the system...'
        if run_root systemctl reboot; then
            exit 0
        fi
        if run_root reboot; then
            exit 0
        fi
        ui_status ERROR 'The reboot command failed. Reboot manually before continuing.'
        exit 1
    fi

    ui_status INFO 'Reboot skipped. Reboot manually when you are ready.'
    ui_status INFO 'The remaining JK Gray configuration stages were not run in this session.'
    exit 0
}

run_archinstall() {
    local config_dir="$HOME/.config/jk-gray"
    local config_file="$config_dir/archinstall-config.json"
    local temporary_file=''

    ui_section 'Archinstall'
    prepare_ntp

    if ! command -v archinstall >/dev/null 2>&1; then
        ui_status INFO 'archinstall is not installed; installing it from the configured repositories.'
        pacman_install archinstall || return 1
    fi
    require_command archinstall 'Arch Linux installation' || return 1

    if [[ -z "${HOME:-}" || "$HOME" == '/' ]]; then
        ui_status ERROR 'HOME is unset or unsafe; refusing to write Archinstall configuration.'
        return 1
    fi

    if ! mkdir -p -- "$config_dir"; then
        ui_status ERROR "Could not create configuration directory: ${config_dir}"
        return 1
    fi

    temporary_file="$(mktemp "$config_dir/.archinstall-config.XXXXXX")" || {
        ui_status ERROR 'Could not create a temporary Archinstall configuration file.'
        return 1
    }
    if ! cat > "$temporary_file" <<'JSON'
{
  "profile_config": {
    "profile": {
      "main": "Desktop",
      "details": ["Hyprland"],
      "custom_settings": {
        "Hyprland": {
          "seat_access": "polkit"
        }
      }
    }
  },
  "packages": [
    "git",
    "firefox"
  ]
}
JSON
    then
        rm -f -- "$temporary_file"
        ui_status ERROR 'Could not write the Archinstall configuration.'
        return 1
    fi

    if ! chmod 600 "$temporary_file"; then
        rm -f -- "$temporary_file"
        ui_status ERROR 'Could not secure the Archinstall configuration file.'
        return 1
    fi
    if ! mv -f -- "$temporary_file" "$config_file"; then
        rm -f -- "$temporary_file"
        ui_status ERROR 'Could not publish the Archinstall configuration.'
        return 1
    fi

    ui_status OK "Archinstall configuration created: ${config_file}"
    ui_status INFO 'The configuration preselects the Desktop / Hyprland profile; review the guided installer before partitioning.'
    ui_status WAIT 'Starting Archinstall...'

    if ! run_root archinstall --config "$config_file"; then
        ui_status ERROR 'Archinstall returned a non-zero exit status.'
        return 1
    fi

    request_reboot_after_installer
}

install_blackarch_from_github() {
    local source_dir="$REPO_ROOT/blackarch-installer"
    local install_dir='/usr/share/blackarch-installer'
    local install_link='/usr/bin/blackarch-install'

    require_command git 'BlackArch installer source checkout' || {
        pacman_install git || return 1
        require_command git 'BlackArch installer source checkout' || return 1
    }

    if [[ -e "$source_dir" && ! -d "$source_dir/.git" ]]; then
        ui_status ERROR "Destination exists but is not a Git repository: ${source_dir}"
        return 1
    fi

    if [[ ! -d "$source_dir/.git" ]]; then
        ui_status WARN 'The BlackArch installer will be downloaded from the official GitHub repository.'
        ui_status WARN 'This installs and executes third-party installer code with administrator privileges.'
        if ! ask_yes_no 'Continue with the GitHub installation?' no; then
            ui_status SKIP 'BlackArch GitHub installation cancelled.'
            return 1
        fi
        ui_command git clone --depth 1 https://github.com/BlackArch/blackarch-installer.git "$source_dir"
        if ! git clone --depth 1 https://github.com/BlackArch/blackarch-installer.git "$source_dir"; then
            ui_status ERROR 'Could not clone the BlackArch installer repository.'
            return 1
        fi
    else
        ui_status INFO 'Using the existing BlackArch installer checkout; it will not be updated automatically.'
    fi

    if [[ ! -f "$source_dir/blackarch-install" ]]; then
        ui_status ERROR "blackarch-install was not found in ${source_dir}."
        return 1
    fi

    if ! run_root install -d -m 755 "$install_dir"; then
        ui_status ERROR 'Could not create the BlackArch installation directory.'
        return 1
    fi
    if ! run_root cp -a "$source_dir/." "$install_dir/"; then
        ui_status ERROR 'Could not copy BlackArch installer files.'
        return 1
    fi
    if ! run_root chmod 755 "$install_dir/blackarch-install"; then
        ui_status ERROR 'Could not set the BlackArch installer executable bit.'
        return 1
    fi
    if ! run_root ln -sfn "$install_dir/blackarch-install" "$install_link"; then
        ui_status ERROR 'Could not create the blackarch-install command link.'
        return 1
    fi

    ui_status OK 'BlackArch installer files installed from GitHub.'
}

run_blackarch_installer() {
    ui_section 'BlackArch Installer'
    prepare_ntp

    if ! command -v blackarch-install >/dev/null 2>&1; then
        if [[ "$BLACKARCH_AVAILABLE" == 'yes' ]]; then
            ui_status INFO 'BlackArch repository detected; installing blackarch-installer.'
            if ! pacman_install blackarch-installer; then
                ui_status WARN 'Repository installation failed; GitHub installation can be used instead.'
                install_blackarch_from_github || return 1
            fi
        else
            ui_status WARN 'The BlackArch repository is not configured.'
            install_blackarch_from_github || return 1
        fi
    fi

    require_command blackarch-install 'BlackArch installer execution' || return 1
    ui_status WAIT 'Starting the BlackArch installer...'
    if ! run_root blackarch-install; then
        ui_status ERROR 'BlackArch installer returned a non-zero exit status.'
        return 1
    fi

    request_reboot_after_installer
}

run_jk_gray_installer() {
    local installer="$REPO_ROOT/jk-arch-installer/arch-installer.py"

    ui_section 'JK Gray Linux Installer'
    if [[ ! -f "$installer" ]]; then
        ui_status ERROR "JK Gray installer not found: ${installer}"
        return 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        ui_status INFO 'Python 3 is not installed; installing it.'
        pacman_install python || return 1
    fi
    require_command python3 'JK Gray Linux installer' || return 1

    prepare_ntp
    ui_status WAIT 'Starting the JK Gray Linux installer...'
    if ! run_root python3 "$installer"; then
        ui_status ERROR 'JK Gray Linux installer returned a non-zero exit status.'
        return 1
    fi

    ui_status OK 'JK Gray Linux base installation completed.'
    printf '\nBase components are configured by the dedicated installer, including:\n'
    printf '  • Arch Linux\n  • Hyprland\n  • Bootloader\n  • NetworkManager\n'
    printf '  • PipeWire / WirePlumber\n  • CPU microcode and GPU support\n  • zram\n\n'
    printf 'Additional hardening and applications can be configured after first boot.\n'
    request_reboot_after_installer
}

run_cachyos_installer() {
    local installer_dir="$CACHYOS_INSTALLER_DIR"
    local binary=''
    local -a candidates=()

    ui_section 'CachyOS New CLI Installer'
    ui_status WARN 'This is an experimental online operating-system installer.'
    printf 'Repository: %s\n\n' "$CACHYOS_INSTALLER_REPOSITORY"

    if ! ask_yes_no 'Continue with the CachyOS installation?' no; then
        ui_status SKIP 'CachyOS installation cancelled.'
        return 0
    fi

    prepare_ntp

    if ! command -v git >/dev/null 2>&1; then
        pacman_install git || return 1
    fi
    pacman_install base-devel cmake pkgconf ninja clang mold llvm || return 1
    require_command cmake 'CachyOS installer build' || return 1
    require_command ninja 'CachyOS installer build' || return 1

    if [[ ! -d "$installer_dir/.git" ]]; then
        if [[ -e "$installer_dir" ]]; then
            ui_status ERROR "CachyOS destination exists but is not a Git repository: ${installer_dir}"
            return 1
        fi
        ui_command git clone --depth 1 "$CACHYOS_INSTALLER_REPOSITORY" "$installer_dir"
        if ! git clone --depth 1 "$CACHYOS_INSTALLER_REPOSITORY" "$installer_dir"; then
            ui_status ERROR 'Could not clone the CachyOS installer repository.'
            return 1
        fi
    fi

    if [[ ! -f "$installer_dir/CMakeLists.txt" ]]; then
        ui_status ERROR 'CachyOS repository is invalid: CMakeLists.txt is missing.'
        return 1
    fi

    ui_status WAIT 'Configuring the CachyOS installer build...'
    if ! cmake -S "$installer_dir" -B "$installer_dir/build"; then
        ui_status ERROR 'CMake configuration failed.'
        return 1
    fi

    ui_status WAIT 'Building the CachyOS installer...'
    if ! cmake --build "$installer_dir/build" --parallel; then
        ui_status ERROR 'CachyOS installer build failed.'
        return 1
    fi

    if [[ -x "$installer_dir/build/cachyos-new-installer" ]]; then
        binary="$installer_dir/build/cachyos-new-installer"
    elif [[ -x "$installer_dir/build/cachyos_new_installer" ]]; then
        binary="$installer_dir/build/cachyos_new_installer"
    else
        mapfile -d '' -t candidates < <(find "$installer_dir/build" -maxdepth 5 -type f \
            \( -name 'cachyos-new-installer' -o -name 'cachyos_new_installer' \) \
            -executable -print0 | sort -z)
        if ((${#candidates[@]} > 0)); then
            binary="${candidates[0]}"
        fi
    fi

    if [[ -z "$binary" || ! -x "$binary" ]]; then
        ui_status ERROR 'Could not locate the built CachyOS installer executable.'
        return 1
    fi

    ui_status OK "CachyOS installer built: ${binary}"
    ui_status WAIT 'Starting the CachyOS installer...'
    if ! run_root "$binary"; then
        ui_status ERROR 'CachyOS installer returned a non-zero exit status.'
        return 1
    fi

    request_reboot_after_installer
}

choose_operating_system_installer() {
    local selection=''

    RUNNING_FROM_ARCHISO='no'
    EXISTING_LINUX_INSTALLATION='no'
    is_archiso && RUNNING_FROM_ARCHISO='yes'
    is_existing_linux_installation && EXISTING_LINUX_INSTALLATION='yes'

    detect_installers
    set_install_recommendation
    show_installation_options

    while true; do
        if [[ "$IS_ARCH_LINUX" != true ]]; then
            ui_status SKIP 'Operating-system installer choices are disabled on non-Arch distributions.'
            selection='5'
        else
            read_choice "Select an option [1-5; Enter = ${INSTALL_RECOMMENDATION}]" selection || return 1
            [[ -z "$selection" ]] && selection="$INSTALL_RECOMMENDATION"
        fi

        case "$selection" in
            1|2|3|4)
                if [[ "$EXISTING_LINUX_INSTALLATION" == 'yes' ]]; then
                    ui_status WARN 'An operating system is already installed on this machine.'
                    ui_status WARN 'The selected installer may repartition or overwrite disks.'
                    if ! ask_yes_no 'I understand the risk and want to launch this installer?' no; then
                        ui_status SKIP 'Operating-system installation was not started.'
                        continue
                    fi
                fi

                case "$selection" in
                    1) run_archinstall || { ui_status WARN 'Archinstall did not complete; choose another option or cancel.'; continue; } ;;
                    2) run_blackarch_installer || { ui_status WARN 'BlackArch installer did not complete; choose another option or cancel.'; continue; } ;;
                    3) run_jk_gray_installer || { ui_status WARN 'JK Gray installer did not complete; choose another option or cancel.'; continue; } ;;
                    4) run_cachyos_installer || { ui_status WARN 'CachyOS installer did not complete; choose another option or cancel.'; continue; } ;;
                esac
                ;;
            5)
                ui_status OK 'Keeping the current operating-system configuration.'
                return 0
                ;;
            *)
                ui_status ERROR 'Invalid installation selection.'
                ui_status INFO 'Choose a value from 1 to 5, or press Enter for the displayed recommendation.'
                ;;
        esac
    done
}

###############################################################################
# Bestehende Phasen der Einrichtung unlogischer Impulse
###############################################################################

print_os_information() {
    local function_name

    if declare -p print_os_group_id_functions >/dev/null 2>&1; then
        for function_name in "${print_os_group_id_functions[@]}"; do
            if declare -F "$function_name" >/dev/null 2>&1; then
                "$function_name"
            else
                ui_status WARN "OS information function is unavailable: ${function_name}"
            fi
        done
    fi
}

start_sudo_keepalive() {
    if declare -F sudo_init_keepalive >/dev/null 2>&1; then
        sudo_init_keepalive
        if declare -F sudo_stop_keepalive >/dev/null 2>&1; then
            trap 'sudo_stop_keepalive' EXIT
        fi
    else
        ui_status WARN 'Project sudo keepalive helper is unavailable; sudo may prompt again.'
    fi
}

run_install_stages() {
    print_os_information

    if declare -F pause >/dev/null 2>&1; then
        pause
    fi

    start_sudo_keepalive

    if [[ "${SKIP_ALLGREETING:-false}" != true ]]; then
        ui_status INFO 'Running greeting stage.'
        # shellcheck source=/dev/null
        source "$SUBCMD_DIR/0.greeting.sh"
    else
        ui_status SKIP 'Greeting stage skipped by option.'
    fi

    if [[ "${SKIP_ALLDEPS:-false}" != true ]]; then
        ui_status INFO 'Running dependency installation stage.'
        # shellcheck source=/dev/null
        source "$SUBCMD_DIR/1.deps-router.sh"
    else
        ui_status SKIP 'Dependency stage skipped by option.'
    fi

    if [[ "${SKIP_ALLSETUPS:-false}" != true ]]; then
        ui_status INFO 'Running setup and service stage.'
        # shellcheck source=/dev/null
        source "$SUBCMD_DIR/2.setups.sh"
    else
        ui_status SKIP 'Setup stage skipped by option.'
    fi

    if [[ "${SKIP_ALLFILES:-false}" != true ]]; then
        ui_status INFO 'Running configuration file stage.'
        # shellcheck source=/dev/null
        source "$SUBCMD_DIR/3.files.sh"
    else
        ui_status SKIP 'Configuration file stage skipped by option.'
    fi

    local fish_settings="$HOME/.config/fish/functions/set-jk-settings.fish"
    if command -v fish >/dev/null 2>&1 && [[ -f "$fish_settings" ]]; then
        ui_status INFO 'Applying JK illogical-impulse Fish settings.'
        if ! fish -c 'source "$argv[1]"; and set-jk-settings' "$fish_settings"; then
            ui_status WARN 'Could not apply JK Fish settings.'
        fi
    fi

    ui_frame 'Installation complete'
    ui_status OK 'The requested illogical-impulse setup stages have finished.'
}

run_single_stage() {
    local stage_file="$1"
    local stage_label="$2"
    local use_sudo_keepalive="$3"

    print_os_information
    if declare -F pause >/dev/null 2>&1; then
        pause
    fi

    if [[ "$use_sudo_keepalive" == 'yes' ]]; then
        start_sudo_keepalive
    fi

    if [[ ! -r "$SUBCMD_DIR/$stage_file" ]]; then
        ui_status ERROR "Stage file not found: ${SUBCMD_DIR}/${stage_file}"
        return 1
    fi

    ui_section "$stage_label"
    # shellcheck source=/dev/null
    source "$SUBCMD_DIR/$stage_file"
}

###############################################################################
# Hauptbefehlsvermittler
###############################################################################

main() {
    local command_name="${1:-}"

    case "$command_name" in
        ''|help|--help|-h)
            showhelp_global
            return 0
            ;;
        install|uninstall|exp-update|exp-merge|resetfirstrun|checkdeps|virtmon)
            SUBCMD_NAME="$command_name"
            SUBCMD_DIR="$REPO_ROOT/sdata/subcmd-$command_name"
            shift
            ;;
        install-deps|install-setups|install-files)
            SUBCMD_NAME="$command_name"
            SUBCMD_DIR="$REPO_ROOT/sdata/subcmd-install"
            shift
            ;;
        *)
            ui_status ERROR "Unknown subcommand: ${command_name}"
            showhelp_global
            return 1
            ;;
    esac

    if [[ ! -d "$SUBCMD_DIR" ]]; then
        ui_status ERROR "Subcommand directory not found: ${SUBCMD_DIR}"
        return 1
    fi

    if [[ -r "$SUBCMD_DIR/options.sh" ]]; then
        # shellcheck source=/dev/null
        source "$SUBCMD_DIR/options.sh"
    fi

    if declare -F prevent_sudo_or_root >/dev/null 2>&1; then
        prevent_sudo_or_root
    fi

    case "$SUBCMD_NAME" in
        install)
            show_jk_gray_banner

            ui_frame 'JK Gray Linux Setup'

            show_security_notice

            RUNNING_FROM_ARCHISO='no'
            EXISTING_LINUX_INSTALLATION='no'
            is_archiso && RUNNING_FROM_ARCHISO='yes'
            is_existing_linux_installation && EXISTING_LINUX_INSTALLATION='yes'

            if is_arch_linux; then
                IS_ARCH_LINUX=true
                ui_status OK 'Arch Linux or CachyOS detected.'
            else
                IS_ARCH_LINUX=false
                confirm_non_arch || return 1
            fi

            if ! configure_privacy; then
                ui_status ERROR 'Network privacy configuration failed. Installation stages were not started.'
                return 1
            fi

            if ! choose_operating_system_installer; then
                return 1
            fi

            ui_frame 'Hyprland configuration'

            ui_status INFO "JK Gray Linux Hyprland configuration is starting now..."

            run_install_stages
            ;;
        install-deps)
            run_single_stage '1.deps-router.sh' 'Dependency installation' yes
            ;;
        install-setups)
            run_single_stage '2.setups.sh' 'Permission and service setup' yes
            ;;
        install-files)
            run_single_stage '3.files.sh' 'Configuration file installation' no
            ;;
        *)
            if [[ ! -r "$SUBCMD_DIR/0.run.sh" ]]; then
                ui_status ERROR "Run file not found: ${SUBCMD_DIR}/0.run.sh"
                return 1
            fi
            # shellcheck source=/dev/null
            source "$SUBCMD_DIR/0.run.sh"
            ;;
    esac
}

main "$@"
