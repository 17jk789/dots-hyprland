{
    // =====================================================================
    // ARCH LINUX / VS CODE + VSCODE-NEOVIM
    // VS Code owns language services, formatting, debugging and workbench UI.
    // Neovim owns modal editing only while running inside VS Code.
    // Paste into: Preferences: Open User Settings (JSON)
    // =====================================================================

    // --- Editor: focused, responsive, Neovim-friendly --------------------
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "editor.fontSize": 15,
    "editor.fontWeight": "400",
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0,
    "editor.lineHeight": 1.6,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.smoothScrolling": false,
    "editor.mouseWheelZoom": true,
    "editor.lineNumbers": "relative",
    "editor.cursorSurroundingLines": 9,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.wordWrap": "off",
    "editor.renderLineHighlight": "gutter",
    "editor.renderWhitespace": "selection",
    "editor.guides.bracketPairs": "active",
    "editor.bracketPairColorization.enabled": true,
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": false,
    "editor.suggest.preview": false,
    "editor.inlineSuggest.enabled": false,
    "editor.largeFileOptimizations": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [100],
    "editor.formatOnSave": false,

    // IntelliSense remains VS Code's responsibility in Insert mode.
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.suggestSelection": "first",
    "editor.acceptSuggestionOnEnter": "on",
    "editor.wordBasedSuggestions": "matchingDocuments",

    // --- Files ------------------------------------------------------------
    "files.autoSave": "off",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.encoding": "utf8",

    // Exclude high-churn/generated trees from watchers and text search.
    // Keep .git itself visible to VS Code's Git integration.
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.git/worktrees/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.next/**": true,
        "**/coverage/**": true
    },
    "search.exclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.next/**": true,
        "**/coverage/**": true
    },
    "search.smartCase": true,
    "search.followSymlinks": false,

    // --- Workbench: quiet Catppuccin layout -------------------------------
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.editor.enablePreview": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 14,
    "workbench.editor.limit.perEditorGroup": true,
    "window.titleBarStyle": "custom",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "window.zoomLevel": 0,

    // --- Security / privacy ----------------------------------------------
    "security.workspace.trust.enabled": true,
    "security.workspace.trust.startupPrompt": "once",
    "security.workspace.trust.untrustedFiles": "prompt",
    "telemetry.telemetryLevel": "off",
    "extensions.autoCheckUpdates": true,
    "extensions.autoUpdate": "on",

    // --- Git --------------------------------------------------------------
    "git.autofetch": false,
    "git.confirmSync": true,
    "git.enableSmartCommit": false,
    "git.openRepositoryInParentFolders": "prompt",
    "gitlens.ai.enabled": false,

    // --- vscode-neovim: real Neovim backend -------------------------------
    // Verify with: command -v nvim
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },

    // --- Terminal: zsh for interactive work -----------------------------
    // Use zsh as the default shell because fish hangs and does not render properly in the VS Code terminal.
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "/usr/bin/zsh",
            "args": ["--login"]
        }
    },
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.gpuAcceleration": "on",
    // "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.fontWeight": "400",
    "terminal.integrated.letterSpacing": 0,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorBlinking": false,
    "terminal.integrated.cursorStyle": "line",
    "terminal.external.linuxExec": "kitty",
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.scrollback": 8000,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.enableMultiLinePasteWarning": "auto",

    // --- Rust Analyzer: Marketplace extension owns the language server -----
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "check",
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.inlayHints.typeHints.enable": true,
    "rust-analyzer.inlayHints.parameterHints.enable": true,
    "rust-analyzer.inlayHints.maxLength": 30,
    "rust-analyzer.lens.enable": false,

    // --- C / C++: clangd extension is the only language engine -------------
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=never"
    ],

    // --- Python: Pylance for language features, Ruff for lint + format -----
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.terminal.activateEnvironment": true,

    // --- Java -------------------------------------------------------------
    "java.configuration.updateBuildConfiguration": "interactive",

    // --- AI: disabled by default -----------------------------------------
    "github.copilot.enable": {
        "*": false
    },

    // --- Language-specific formatters -----------------------------------
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "[rust]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[java]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "redhat.java"
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[html]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[scss]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.trimTrailingWhitespace": false
    },
    "[shellscript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "MufanQiu.shell-format-wasm"
    },
    "[fish]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "bmalehorn.vscode-fish"
    },
    "[latex]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100,
        "editor.wrappingIndent": "indent"
    }
}

