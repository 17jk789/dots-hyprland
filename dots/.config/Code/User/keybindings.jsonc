[
    // Leader-space passthrough. Do not add multi-step space chords here:
    // VS Code keybindings support two-stroke chords only. LazyVim's longer
    // leader sequences (for example <leader>xx and <leader>tt) are handled by
    // Neovim's keymap engine.
    {
        "key": "space",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.init && neovim.mode != insert",
        "args": " "
    },

    // Explicit control-key forwarding in Normal mode.
    { "key": "ctrl+p", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-p>" },
    { "key": "ctrl+f", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-f>" },
    { "key": "ctrl+o", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-o>" },
    { "key": "ctrl+b", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-b>" },
    { "key": "ctrl+s", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-s>" },
    { "key": "ctrl+shift+p", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<C-S-p>" },

    // H/L navigate VS Code editor tabs in Normal mode.
    { "key": "shift+h", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<S-h>" },
    { "key": "shift+l", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<S-l>" },

    // Debugger function keys.
    { "key": "f5", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<F5>" },
    { "key": "f9", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<F9>" },
    { "key": "f10", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<F10>" },
    { "key": "f11", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<F11>" },
    { "key": "f12", "command": "vscode-neovim.send", "when": "editorTextFocus && neovim.init && neovim.mode == normal", "args": "<F12>" }
]
