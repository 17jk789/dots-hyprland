{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "blackarch",
        // "source": "~/.config/fastfetch/arch.txt",
        // "source": "~/Pictures/ba-logo-transp.png",
        "color": {
            "1": "#89b4fa",
            "2": "#b4befe",
            "3": "#cba6f7",
            "4": "#f5c2e7",
            "5": "#f38ba8",
            "6": "#fab387",
            "7": "#f9e2af",
            "8": "#a6e3a1",
            "9": "#94e2d5"
        }
    },
    "modules": [
        "title",
        // {
        //   "type": "title",
        //   "format": "jk@JK-Arch"
        // },
        "separator",
        {
            "type": "os",
            "format": "Arch Linux x86_64"
        },
        "host",
        {
            "type": "kernel",
            "format": "{release}-peharge"
        },
        "uptime",
        "packages",
        {
            "type": "shell",
            "format": "PP-Term 8.3.9.26980"
        },
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        {
            "type": "terminal",
            "format": "Peharge Kernel 8.0.3.6984"
        },
        "terminalfont",
        // "cpu",
        // "gpu",
        "memory",
        // "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors",
        "break"
    ]
}
