{
    "id": "install_lazygit",

    "name": {
        "de": "LazyGit installieren",
        "en": "Install LazyGit"
    },

    "description": {
        "de": "Installiert LazyGit als interaktives Terminal-Frontend für die komfortable Verwaltung von Git-Repositories.",
        "en": "Installs LazyGit as an interactive terminal frontend for convenient Git repository management."
    },

    "question": {
        "de": "Soll LazyGit installiert werden?",
        "en": "Should LazyGit be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert LazyGit über Pacman.",
                "en": "Installs LazyGit using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "lazygit"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
