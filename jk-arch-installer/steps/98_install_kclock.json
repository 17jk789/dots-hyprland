{
    "id": "install_kclock",

    "name": {
        "de": "KClock installieren",
        "en": "Install KClock"
    },

    "description": {
        "de": "Installiert KClock für Uhrzeit, Datum, Wecker, Timer und Weltzeituhr.",
        "en": "Installs KClock for time, date, alarms, timers, and world clock functionality."
    },

    "question": {
        "de": "Soll KClock installiert werden?",
        "en": "Should KClock be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert KClock über Pacman.",
                "en": "Installs KClock using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "kclock"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
