{
    "id": "install_libheif",

    "name": {
        "de": "libheif installieren",
        "en": "Install libheif"
    },

    "description": {
        "de": "Installiert libheif zur Verarbeitung, Konvertierung und Unterstützung von HEIF- und AVIF-Bildformaten.",
        "en": "Installs libheif for processing, converting, and supporting HEIF and AVIF image formats."
    },

    "question": {
        "de": "Soll libheif installiert werden?",
        "en": "Should libheif be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert libheif über Pacman.",
                "en": "Installs libheif using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "libheif"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
