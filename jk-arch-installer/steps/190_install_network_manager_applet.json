{
    "id": "install_network_manager_applet",
    "name": {
        "de": "NetworkManager Applet installieren",
        "en": "Install NetworkManager Applet"
    },
    "description": {
        "de": "Installiert das NetworkManager-Applet zur grafischen Netzwerkverwaltung.",
        "en": "Installs the NetworkManager applet for graphical network management."
    },
    "question": {
        "de": "Soll das NetworkManager-Applet installiert werden?",
        "en": "Should the NetworkManager applet be installed?"
    },
    "optional": false,
    "continue_on_error": false,
    "checks": [],
    "commands": [
        {
            "description": {
                "de": "Installiert network-manager-applet über Pacman.",
                "en": "Installs network-manager-applet using Pacman."
            },
            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "network-manager-applet"
            ],
            "requires_root": true,
            "distros": [
                "arch_based"
            ]
        }
    ]
}
