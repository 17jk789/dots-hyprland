{
    "id": "install_ripgrep",

    "name": {
        "de": "Ripgrep installieren",
        "en": "Install ripgrep"
    },

    "description": {
        "de": "Installiert ripgrep für ultraschnelle Textsuche mit Unterstützung für .gitignore.",
        "en": "Installs ripgrep for extremely fast text searching with .gitignore support."
    },

    "question": {
        "de": "Soll Ripgrep jetzt installiert werden?",
        "en": "Should ripgrep be installed now?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert ripgrep über Pacman.",
                "en": "Installs ripgrep using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "ripgrep"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
