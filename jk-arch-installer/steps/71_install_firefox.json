{
    "id": "install_firefox",

    "variants": {
        "pacman": {
            "id": "install_firefox_pacman",

            "name": {
                "de": "Firefox über Pacman installieren",
                "en": "Install Firefox with Pacman"
            },

            "description": {
                "de": "Installiert Firefox über die offiziellen Arch-Repositories mit Pacman.",
                "en": "Installs Firefox from the official Arch repositories using Pacman."
            },

            "question": {
                "de": "Soll Firefox über Pacman installiert werden?",
                "en": "Should Firefox be installed using Pacman?"
            },

            "optional": false,

            "exclusive_group": "firefox_method",

            "continue_on_error": false,

            "checks": [],

            "commands": [
                {
                    "description": {
                        "de": "Installiert Firefox über Pacman.",
                        "en": "Installs Firefox using Pacman."
                    },

                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "firefox"
                    ],

                    "requires_root": true,

                    "distros": [
                        "arch_based"
                    ]
                }
            ]
        },

        "yay": {
            "id": "install_firefox_yay",

            "name": {
                "de": "Firefox über yay installieren",
                "en": "Install Firefox with yay"
            },

            "description": {
                "de": "Installiert Firefox über das AUR mit yay.",
                "en": "Installs Firefox from the AUR using yay."
            },

            "question": {
                "de": "Soll Firefox über yay installiert werden?",
                "en": "Should Firefox be installed using yay?"
            },

            "optional": true,

            "exclusive_group": "firefox_method",

            "continue_on_error": false,

            "checks": [],

            "commands": [
                {
                    "description": {
                        "de": "Installiert Firefox über yay.",
                        "en": "Installs Firefox using yay."
                    },

                    "command": [
                        "yay",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "firefox"
                    ],

                    "requires_root": false,

                    "distros": [
                        "arch_based"
                    ]
                }
            ]
        }
    }
}
