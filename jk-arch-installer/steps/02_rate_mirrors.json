{
    "id": "rate_mirrors",
    "variants": {
        "arch": {
            "id": "rate_mirrors_arch",
            "name": {
                "de": "Schnellste Arch-Mirrors finden",
                "en": "Find fastest Arch mirrors"
            },
            "description": {
                "de": "Ermittelt und speichert die schnellsten Arch-Mirror-Server, ohne das System anschließend zu aktualisieren.",
                "en": "Finds and saves the fastest Arch mirror servers without updating the system afterwards."
            },
            "question": {
                "de": "Sollen die schnellsten Arch-Mirrors ermittelt werden?",
                "en": "Do you want to find the fastest Arch mirrors?"
            },
            "optional": true,
            "exclusive_group": "mirror_method",
            "continue_on_error": true,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Reflector.",
                        "en": "Installs Reflector."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "reflector"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch"
                    ]
                },
                {
                    "description": {
                        "de": "Testet die verfügbaren Arch-Mirrors und speichert die schnellsten in der Mirrorliste.",
                        "en": "Tests the available Arch mirrors and saves the fastest ones to the mirror list."
                    },
                    "command": [
                        "reflector",
                        "--latest",
                        "20",
                        "--sort",
                        "rate",
                        "--save",
                        "/etc/pacman.d/mirrorlist"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch"
                    ]
                }
            ]
        },
        "cachyos": {
            "id": "rate_mirrors_cachyos",
            "name": {
                "de": "Schnellste CachyOS-Mirrors finden",
                "en": "Find fastest CachyOS mirrors"
            },
            "description": {
                "de": "Ermittelt die schnellsten CachyOS-Mirror-Server, ohne das System anschließend zu aktualisieren.",
                "en": "Finds the fastest CachyOS mirror servers without updating the system afterwards."
            },
            "question": {
                "de": "Sollen die schnellsten CachyOS-Mirrors ermittelt werden?",
                "en": "Do you want to find the fastest CachyOS mirrors?"
            },
            "optional": true,
            "exclusive_group": "mirror_method",
            "continue_on_error": true,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert das CachyOS-Mirror-Ranking-Werkzeug.",
                        "en": "Installs the CachyOS mirror ranking tool."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "cachyos-rate-mirrors"
                    ],
                    "requires_root": true,
                    "distros": [
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Testet die verfügbaren CachyOS-Mirrors und wählt die schnellsten aus.",
                        "en": "Tests the available CachyOS mirrors and selects the fastest ones."
                    },
                    "command": [
                        "cachyos-rate-mirrors"
                    ],
                    "requires_root": true,
                    "distros": [
                        "cachyos"
                    ]
                }
            ]
        },
        "arch_update": {
            "id": "rate_mirrors_arch_update",
            "name": {
                "de": "Arch-Mirrors finden und System aktualisieren",
                "en": "Find Arch mirrors and update system"
            },
            "description": {
                "de": "Ermittelt die schnellsten Arch-Mirrors und aktualisiert anschließend das gesamte System.",
                "en": "Finds the fastest Arch mirrors and then updates the entire system."
            },
            "question": {
                "de": "Sollen die schnellsten Arch-Mirrors ermittelt und anschließend das System aktualisiert werden?",
                "en": "Do you want to find the fastest Arch mirrors and then update the system?"
            },
            "optional": true,
            "exclusive_group": "mirror_method",
            "continue_on_error": true,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Reflector.",
                        "en": "Installs Reflector."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "reflector"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch"
                    ]
                },
                {
                    "description": {
                        "de": "Testet die verfügbaren Arch-Mirrors und speichert die schnellsten in der Mirrorliste.",
                        "en": "Tests the available Arch mirrors and saves the fastest ones to the mirror list."
                    },
                    "command": [
                        "reflector",
                        "--latest",
                        "20",
                        "--sort",
                        "rate",
                        "--save",
                        "/etc/pacman.d/mirrorlist"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch"
                    ]
                },
                {
                    "description": {
                        "de": "Aktualisiert anschließend das gesamte Arch-System.",
                        "en": "Then updates the entire Arch system."
                    },
                    "command": [
                        "pacman",
                        "-Syu",
                        "--noconfirm"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch"
                    ]
                }
            ]
        },
