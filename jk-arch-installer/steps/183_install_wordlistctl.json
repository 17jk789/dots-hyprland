{
    "id": "install_wordlistctl",
    "name": {
        "de": "Wordlistctl installieren",
        "en": "Install Wordlistctl"
    },
    "description": {
        "de": "Installiert Wordlistctl zur Verwaltung von Wortlisten.",
        "en": "Installs Wordlistctl for managing wordlists."
    },
    "question": {
        "de": "Soll Wordlistctl installiert werden?",
        "en": "Should Wordlistctl be installed?"
    },
    "optional": true,
    "continue_on_error": false,
    "checks": [],
    "commands": [
        {
            "description": {
                "de": "Installiert das Paket wordlistctl über Pacman.",
                "en": "Installs the wordlistctl package using Pacman."
            },
            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "wordlistctl"
            ],
            "requires_root": true,
            "distros": [
                "arch_based"
            ]
        }
    ]
}
