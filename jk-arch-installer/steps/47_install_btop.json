{
    "id": "install_btop",

    "name": {
        "de": "btop installieren",
        "en": "Install btop"
    },

    "description": {
        "de": "Installiert btop als modernen und detaillierten System-Monitor zur Überwachung von CPU, RAM, Netzwerk und Prozessen.",
        "en": "Installs btop as a modern and detailed system monitor for CPU, RAM, network, and process monitoring."
    },

    "question": {
        "de": "Soll btop installiert werden?",
        "en": "Should btop be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert btop über Pacman.",
                "en": "Installs btop using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "btop"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
