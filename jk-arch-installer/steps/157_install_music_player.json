{
    "id": "install_music_player",

    "variants": {
        "amberol": {
            "id": "install_music_player_amberol",

            "name": {
                "de": "Amberol installieren (GNOME)",
                "en": "Install Amberol (GNOME)"
            },

            "description": {
                "de": "Installiert Amberol über Pacman.",
                "en": "Installs Amberol using Pacman."
            },

            "question": {
                "de": "Soll Amberol installiert werden?",
                "en": "Should Amberol be installed?"
            },

            "optional": true,

            "exclusive_group": "music_player_method",

            "continue_on_error": false,

            "checks": [],

            "commands": [
                {
                    "description": {
                        "de": "Installiert Amberol über Pacman.",
                        "en": "Installs Amberol using Pacman."
                    },

                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "amberol"
                    ],

                    "requires_root": true,

                    "distros": [
                        "arch_based"
                    ]
                }
            ]
        },


        "amarok": {
