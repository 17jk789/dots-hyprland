{
    "id": "install_thefuck",

    "name": {
        "de": "thefuck installieren",
        "en": "Install thefuck"
    },

    "description": {
        "de": "Installiert thefuck zur automatischen Korrektur häufiger Tippfehler bei Terminal-Befehlen.",
        "en": "Installs thefuck for automatically correcting common command-line mistakes."
    },

    "question": {
        "de": "Soll thefuck installiert werden?",
        "en": "Should thefuck be installed?"
    },

    "optional": true,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert thefuck über Pacman.",
                "en": "Installs thefuck using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "thefuck"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
