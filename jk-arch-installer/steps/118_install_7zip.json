{
    "id": "install_7zip",

    "name": {
        "de": "7-Zip installieren",
        "en": "Install 7-Zip"
    },

    "description": {
        "de": "Installiert 7-Zip zum Erstellen, Extrahieren und Verwalten komprimierter Dateien und Archive.",
        "en": "Installs 7-Zip for creating, extracting, and managing compressed files and archives."
    },

    "question": {
        "de": "Soll 7-Zip installiert werden?",
        "en": "Should 7-Zip be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert 7-Zip über Pacman.",
                "en": "Installs 7-Zip using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "7zip"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
