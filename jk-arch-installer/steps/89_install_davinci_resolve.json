            "question": {
                "de": "Soll DaVinci Resolve mit AMD-Unterstützung installiert werden?",
                "en": "Should DaVinci Resolve be installed with AMD support?"
            },

            "optional": true,

            "exclusive_group": "davinci_resolve_gpu",

            "continue_on_error": false,

            "checks": [],

            "commands": [
