                    },

                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "davinci-resolve"
                    ],

                    "requires_root": true,

                    "distros": [
                        "arch_based"
                    ]
                },
                {
                    "description": {
