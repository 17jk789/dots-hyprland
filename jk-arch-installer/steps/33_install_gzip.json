{
    "id": "install_gzip",

    "name": {
        "de": "Gzip installieren",
        "en": "Install gzip"
    },

    "description": {
        "de": "Installiert gzip für das Komprimieren und Entpacken von .gz-Dateien.",
        "en": "Installs gzip for compressing and extracting .gz files."
    },

    "question": {
        "de": "Soll gzip jetzt installiert werden?",
        "en": "Should gzip be installed now?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert gzip über Pacman.",
                "en": "Installs gzip using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "gzip"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
