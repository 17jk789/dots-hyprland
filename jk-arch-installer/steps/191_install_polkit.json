{
    "id": "install_polkit",
    "name": {
        "de": "Polkit installieren",
        "en": "Install Polkit"
    },
    "description": {
        "de": "Installiert Polkit zur Verwaltung privilegierter Aktionen und administrativer Berechtigungen.",
        "en": "Installs Polkit for managing privileged actions and administrative permissions."
    },
    "question": {
        "de": "Soll Polkit installiert werden?",
        "en": "Should Polkit be installed?"
    },
    "optional": true,
    "continue_on_error": false,
    "checks": [
        {
            "type": "package_installed",
            "package": "polkit"
        }
    ],
    "commands": [
        {
            "description": {
                "de": "Installiert Polkit über Pacman.",
                "en": "Installs Polkit using Pacman."
            },
            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "polkit"
            ],
            "requires_root": true,
            "distros": [
                "arch_based"
            ]
        }
    ]
}
