{
    "id": "install_vscode_extensions",

    "name": {
        "de": "VS Code Erweiterungen installieren",
        "en": "Install VS Code extensions"
    },

    "description": {
        "de": "Installiert die konfigurierten Visual-Studio-Code-Erweiterungen für C/C++, Rust, Python, Java, Git und Markdown.",
        "en": "Installs the configured Visual Studio Code extensions for C/C++, Rust, Python, Java, Git, and Markdown."
    },

    "question": {
        "de": "Sollen die VS Code Erweiterungen jetzt installiert werden?",
        "en": "Should the VS Code extensions be installed now?"
    },

    "optional": true,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert die Assembly-Syntax-Erweiterung.",
                "en": "Installs the assembly syntax extension."
            },

            "command": [
                "code",
                "--install-extension",
                "13xforever.language-x86-64-assembly"
            ],

            "requires_root": false,

            "distros": [
                "arch_based"
            ]
        },

        {
