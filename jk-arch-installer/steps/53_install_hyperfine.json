{
    "id": "install_hyperfine",

    "name": {
        "de": "Hyperfine installieren",
        "en": "Install Hyperfine"
    },

    "description": {
        "de": "Installiert Hyperfine als modernes Kommandozeilenwerkzeug für präzises Benchmarking von Programmen und Befehlen.",
        "en": "Installs Hyperfine as a modern command-line tool for precise benchmarking of programs and commands."
    },

    "question": {
        "de": "Soll Hyperfine installiert werden?",
        "en": "Should Hyperfine be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Hyperfine über Pacman.",
                "en": "Installs Hyperfine using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "hyperfine"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
