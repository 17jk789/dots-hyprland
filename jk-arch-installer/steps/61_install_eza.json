{
    "id": "install_eza",

    "name": {
        "de": "eza installieren",
        "en": "Install eza"
    },

    "description": {
        "de": "Installiert eza als moderne und übersichtliche Alternative zu ls mit zusätzlichen Funktionen wie Icons und Git-Status.",
        "en": "Installs eza as a modern and clear alternative to ls with features such as icons and Git status."
    },

    "question": {
        "de": "Soll eza installiert werden?",
        "en": "Should eza be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert eza über Pacman.",
                "en": "Installs eza using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "eza"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
