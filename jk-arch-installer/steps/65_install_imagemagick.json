{
    "id": "install_imagemagick",

    "name": {
        "de": "ImageMagick installieren",
        "en": "Install ImageMagick"
    },

    "description": {
        "de": "Installiert ImageMagick zur Bearbeitung, Konvertierung und Erstellung von Bildern.",
        "en": "Installs ImageMagick for editing, converting, and creating images."
    },

    "question": {
        "de": "Soll ImageMagick installiert werden?",
        "en": "Should ImageMagick be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert ImageMagick über Pacman.",
                "en": "Installs ImageMagick using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "imagemagick"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
