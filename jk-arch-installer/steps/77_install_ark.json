{
    "id": "install_ark",

    "name": {
        "de": "Ark installieren",
        "en": "Install Ark"
    },

    "description": {
        "de": "Installiert Ark als grafisches Programm zum Erstellen, Extrahieren und Verwalten von Archiven.",
        "en": "Installs Ark as a graphical application for creating, extracting, and managing archives."
    },

    "question": {
        "de": "Soll Ark installiert werden?",
        "en": "Should Ark be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Ark über Pacman.",
                "en": "Installs Ark using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "ark"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
