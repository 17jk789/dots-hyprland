{
    "id": "install_radare2",

    "name": {
        "de": "Radare2 installieren",
        "en": "Install Radare2"
    },

    "description": {
        "de": "Installiert Radare2 (r2) als leistungsfähiges Framework für Reverse Engineering, Binary-Analyse und Debugging.",
        "en": "Installs Radare2 (r2) as a powerful framework for reverse engineering, binary analysis, and debugging."
    },

    "question": {
        "de": "Soll Radare2 installiert werden?",
        "en": "Should Radare2 be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Radare2 über Pacman.",
                "en": "Installs Radare2 using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "radare2"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
