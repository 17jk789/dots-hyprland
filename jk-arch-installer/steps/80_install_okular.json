{
    "id": "install_okular",

    "name": {
        "de": "Okular installieren",
        "en": "Install Okular"
    },

    "description": {
        "de": "Installiert Okular als universellen Dokumentenbetrachter für verschiedene Dateiformate.",
        "en": "Installs Okular as a universal document viewer for various file formats."
    },

    "question": {
        "de": "Soll Okular installiert werden?",
        "en": "Should Okular be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Okular über Pacman.",
                "en": "Installs Okular using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "okular"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
