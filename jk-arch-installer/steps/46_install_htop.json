{
    "id": "install_htop",

    "name": {
        "de": "htop installieren",
        "en": "Install htop"
    },

    "description": {
        "de": "Installiert htop als interaktiven Prozess-Viewer für eine übersichtliche Darstellung laufender Prozesse.",
        "en": "Installs htop as an interactive process viewer for an easy-to-read overview of running processes."
    },

    "question": {
        "de": "Soll htop installiert werden?",
        "en": "Should htop be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert htop über Pacman.",
                "en": "Installs htop using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "htop"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
