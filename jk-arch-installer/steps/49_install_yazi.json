{
    "id": "install_yazi",

    "name": {
        "de": "Yazi installieren",
        "en": "Install Yazi"
    },

    "description": {
        "de": "Installiert Yazi als ultraschnellen Terminal-Dateimanager für einen modernen, tastaturzentrierten Workflow.",
        "en": "Installs Yazi as an ultra-fast terminal file manager for a modern, keyboard-centered workflow."
    },

    "question": {
        "de": "Soll Yazi installiert werden?",
        "en": "Should Yazi be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Yazi über Pacman.",
                "en": "Installs Yazi using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "yazi"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
