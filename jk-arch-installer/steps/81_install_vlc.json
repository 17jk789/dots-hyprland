{
    "id": "install_vlc",

    "name": {
        "de": "VLC installieren",
        "en": "Install VLC"
    },

    "description": {
        "de": "Installiert VLC als vielseitigen Medienplayer für Audio- und Videodateien.",
        "en": "Installs VLC as a versatile media player for audio and video files."
    },

    "question": {
        "de": "Soll VLC installiert werden?",
        "en": "Should VLC be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert VLC über Pacman.",
                "en": "Installs VLC using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "vlc"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
