{
    "id": "install_blackarch_artwork",
    "name": {
        "de": "BlackArch-Design installieren",
        "en": "Install BlackArch Artwork"
    },
    "description": {
        "de": "Installiert das visuelle Artwork-Paket von BlackArch.",
        "en": "Installs the BlackArch visual artwork package."
    },
    "question": {
        "de": "Soll das BlackArch-Artwork installiert werden?",
        "en": "Should BlackArch artwork be installed?"
    },
    "optional": true,
    "continue_on_error": false,
    "checks": [],
    "commands": [
        {
            "description": {
                "de": "Installiert blackarch-artwork über Pacman.",
                "en": "Installs blackarch-artwork using Pacman."
            },
            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "blackarch-artwork"
            ],
            "requires_root": true,
            "distros": [
                "arch_based"
            ]
        }
    ]
}
