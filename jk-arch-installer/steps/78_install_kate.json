{
    "id": "install_kate",

    "name": {
        "de": "Kate installieren",
        "en": "Install Kate"
    },

    "description": {
        "de": "Installiert Kate als leistungsfähigen Texteditor für Entwickler und fortgeschrittene Benutzer.",
        "en": "Installs Kate as a powerful text editor for developers and advanced users."
    },

    "question": {
        "de": "Soll Kate installiert werden?",
        "en": "Should Kate be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Kate über Pacman.",
                "en": "Installs Kate using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "kate"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
