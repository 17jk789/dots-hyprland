{
    "id": "install_ghex",

    "name": {
        "de": "GHex installieren",
        "en": "Install GHex"
    },

    "description": {
        "de": "Installiert GHex als grafischen Hex-Editor zum direkten Bearbeiten von Binärdateien.",
        "en": "Installs GHex as a graphical hex editor for directly editing binary files."
    },

    "question": {
        "de": "Soll GHex installiert werden?",
        "en": "Should GHex be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert GHex über Pacman.",
                "en": "Installs GHex using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "ghex"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
