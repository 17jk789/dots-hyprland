{
    "id": "install_gnome",
    "variants": {
        "standard": {
            "id": "install_gnome_standard",
            "name": {
                "de": "GNOME installieren",
                "en": "Install GNOME"
            },
            "description": {
                "de": "Installiert die normale GNOME-Desktopumgebung ohne Display-Manager.",
                "en": "Installs the standard GNOME desktop environment without a display manager."
            },
            "question": {
                "de": "Soll GNOME in der Standard-Variante installiert werden?",
                "en": "Should GNOME be installed using the standard variant?"
            },
            "optional": true,
            "exclusive_group": "gnome_installation",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert GNOME.",
                        "en": "Installs GNOME."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "gnome"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "standard_gdm": {
            "id": "install_gnome_standard_gdm",
            "name": {
                "de": "GNOME mit GDM installieren",
                "en": "Install GNOME with GDM"
            },
            "description": {
                "de": "Installiert GNOME und aktiviert GDM als Display-Manager.",
                "en": "Installs GNOME and enables GDM as the display manager."
            },
            "question": {
                "de": "Soll GNOME mit GDM als Display-Manager installiert werden?",
                "en": "Should GNOME be installed with GDM as the display manager?"
            },
            "optional": true,
            "exclusive_group": "gnome_installation",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert GNOME.",
                        "en": "Installs GNOME."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "gnome"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert GDM dauerhaft und startet den Display-Manager sofort.",
                        "en": "Enables GDM permanently and starts the display manager immediately."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "gdm"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "extra": {
            "id": "install_gnome_extra",
            "name": {
                "de": "GNOME mit Extras installieren",
                "en": "Install GNOME with extras"
            },
            "description": {
                "de": "Installiert GNOME inklusive zusätzlicher GNOME-Extra-Pakete ohne Display-Manager.",
                "en": "Installs GNOME including additional GNOME Extra packages without a display manager."
            },
            "question": {
                "de": "Soll GNOME mit zusätzlichen GNOME-Paketen installiert werden?",
                "en": "Should GNOME be installed with additional GNOME packages?"
            },
            "optional": true,
            "exclusive_group": "gnome_installation",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert GNOME und die zusätzlichen GNOME-Extra-Pakete.",
                        "en": "Installs GNOME and the additional GNOME Extra packages."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "gnome",
                        "gnome-extra"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "extra_gdm": {
            "id": "install_gnome_extra_gdm",
            "name": {
                "de": "GNOME mit Extras und GDM installieren",
