            "description": {
                "de": "Installiert GNOME mit zusätzlichen GNOME-Extra-Paketen und aktiviert GDM als Display-Manager.",
                "en": "Installs GNOME with additional GNOME Extra packages and enables GDM as the display manager."
            },
            "question": {
                "de": "Soll GNOME mit zusätzlichen Paketen und GDM installiert werden?",
                "en": "Should GNOME be installed with additional packages and GDM?"
            },
            "optional": true,
            "exclusive_group": "gnome_installation",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert GNOME und die zusätzlichen GNOME-Extra-Pakete.",
                        "en": "Installs GNOME and the additional GNOME Extra packages."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "gnome",
                        "gnome-extra"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert GDM dauerhaft und startet den Display-Manager sofort.",
                        "en": "Enables GDM permanently and starts the display manager immediately."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "gdm"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        }
    }
}
