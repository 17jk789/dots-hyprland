{
    "id": "install_maven",

    "name": {
        "de": "Maven installieren",
        "en": "Install Maven"
    },

    "description": {
        "de": "Installiert Maven für das Verwalten von Abhängigkeiten, Ausführen von Tests und Erstellen von Java-Projekten.",
        "en": "Installs Maven for dependency management, running tests, and building Java projects."
    },

    "question": {
        "de": "Soll Maven jetzt installiert werden?",
        "en": "Should Maven be installed now?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Maven über Pacman.",
                "en": "Installs Maven using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "maven"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
