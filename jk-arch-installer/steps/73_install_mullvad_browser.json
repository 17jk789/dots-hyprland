{
    "id": "install_mullvad_browser",
    "variants": {
        "pacman": {
            "id": "install_mullvad_browser_pacman",
            "name": {
                "de": "Mullvad Browser über Pacman installieren",
                "en": "Install Mullvad Browser with Pacman"
            },
            "description": {
                "de": "Installiert den Mullvad Browser über die offiziellen Paketquellen mit Pacman.",
                "en": "Installs the Mullvad Browser from the official repositories using Pacman."
            },
            "question": {
                "de": "Soll der Mullvad Browser über Pacman installiert werden?",
                "en": "Should the Mullvad Browser be installed using Pacman?"
            },
            "optional": false,
            "exclusive_group": "mullvad_browser_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert den Mullvad Browser über Pacman.",
                        "en": "Installs the Mullvad Browser using Pacman."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "mullvad-browser-bin"
                    ],
                    "requires_root": true,
                    "distros": [
                        "cachyos"
                    ]
                }
            ]
        },
        "yay": {
            "id": "install_mullvad_browser_yay",
            "name": {
                "de": "Mullvad Browser über yay installieren",
                "en": "Install Mullvad Browser with yay"
            },
            "description": {
                "de": "Installiert den datenschutzfokussierten Mullvad Browser über das AUR mit yay.",
                "en": "Installs the privacy-focused Mullvad Browser from the AUR using yay."
            },
            "question": {
                "de": "Soll der Mullvad Browser über yay installiert werden?",
                "en": "Should the Mullvad Browser be installed using yay?"
            },
            "optional": true,
            "exclusive_group": "mullvad_browser_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert den Mullvad Browser über yay.",
                        "en": "Installs the Mullvad Browser using yay."
                    },
                    "command": [
                        "yay",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "mullvad-browser-bin"
                    ],
                    "requires_root": false,
                    "distros": [
                        "arch_based"
                    ]
                }
            ]
        },
        "flatpak": {
            "id": "install_mullvad_browser_flatpak",
            "name": {
                "de": "Mullvad Browser über Flatpak installieren",
                "en": "Install Mullvad Browser with Flatpak"
            },
            "description": {
                "de": "Installiert den datenschutzfokussierten Mullvad Browser über Flathub mit Flatpak.",
                "en": "Installs the privacy-focused Mullvad Browser from Flathub using Flatpak."
            },
            "question": {
                "de": "Soll der Mullvad Browser über Flatpak installiert werden?",
                "en": "Should the Mullvad Browser be installed using Flatpak?"
            },
            "optional": true,
            "exclusive_group": "mullvad_browser_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert den Mullvad Browser über Flatpak.",
                        "en": "Installs the Mullvad Browser using Flatpak."
                    },
                    "command": [
                        "flatpak",
                        "install",
                        "--noninteractive",
                        "flathub",
                        "net.mullvad.MullvadBrowser"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch_based"
                    ]
                }
            ]
        }
    }
}
