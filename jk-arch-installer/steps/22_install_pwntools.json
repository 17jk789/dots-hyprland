{
    "id": "install_pwntools",

    "name": {
        "de": "Pwntools installieren",
        "en": "Install Pwntools"
    },

    "description": {
        "de": "Installiert Pwntools als Python-Framework für Binary Exploitation und automatisierte Security-Tests.",
        "en": "Installs Pwntools as a Python framework for binary exploitation and automated security testing."
    },

    "question": {
        "de": "Soll Pwntools jetzt installiert werden?",
        "en": "Should Pwntools be installed now?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Pwntools über Pacman.",
                "en": "Installs Pwntools using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "python-pwntools"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        },

        {
            "description": {
                "de": "Überprüft, ob Pwntools erfolgreich importiert werden kann.",
                "en": "Checks whether Pwntools can be imported successfully."
            },

            "command": [
                "python",
                "-c",
                "from pwn import *; print('Pwntools funktioniert!')"
            ],

            "requires_root": false,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
