{
    "id": "install_ollama",

    "name": {
        "de": "Lokale KI-Laufzeitumgebung Ollama installieren",
        "en": "Install local AI runtime Ollama"
    },

    "description": {
        "de": "Installiert Ollama zum lokalen Ausführen verschiedener KI-Modelle auf dem System.",
        "en": "Installs Ollama for running various AI models locally on the system."
    },

    "question": {
        "de": "Soll die lokale KI-Laufzeitumgebung Ollama installiert werden?",
        "en": "Should the local AI runtime Ollama be installed?"
    },

    "optional": true,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Ollama über Pacman.",
                "en": "Installs Ollama using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "ollama"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
