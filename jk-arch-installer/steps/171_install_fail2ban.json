{
    "id": "install_fail2ban",
    "name": {
        "de": "Fail2Ban installieren",
        "en": "Install Fail2Ban"
    },
    "description": {
        "de": "Wähle zwischen verschiedenen Fail2Ban-Installations- und Konfigurationsvarianten.",
        "en": "Choose between different Fail2Ban installation and configuration variants."
    },
    "question": {
        "de": "Welche Fail2Ban-Variante soll verwendet werden?",
        "en": "Which Fail2Ban variant should be used?"
    },
    "optional": true,
    "continue_on_error": false,
    "checks": [],
    "variants": {
        "install_only": {
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban ohne zusätzliche Konfiguration.",
                        "en": "Installs Fail2Ban without additional configuration."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "with_config": {
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Erstellt die lokale Fail2Ban-Konfiguration für SSH.",
                        "en": "Creates the local Fail2Ban configuration for SSH."
                    },
                    "command": [
                        "sh",
                        "-c",
                        "cat > /etc/fail2ban/jail.local <<'EOF'\n[DEFAULT]\nbantime = 1h\nfindtime = 10m\nmaxretry = 5\nbanaction = nftables-multiport\n\n[sshd]\nenabled = true\nport = ssh\nbackend = systemd\nEOF"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert und startet Fail2Ban.",
                        "en": "Enables and starts Fail2Ban."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "fail2ban.service"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Überprüft den Status des SSH-Jails.",
                        "en": "Checks the status of the SSH jail."
                    },
                    "command": [
                        "fail2ban-client",
                        "status",
                        "sshd"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "install_only_enable": {
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert und startet Fail2Ban ohne zusätzliche Konfiguration.",
                        "en": "Enables and starts Fail2Ban without additional configuration."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "fail2ban.service"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "with_config_no_enable": {
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Erstellt die lokale Fail2Ban-Konfiguration für SSH.",
                        "en": "Creates the local Fail2Ban configuration for SSH."
                    },
                    "command": [
                        "sh",
                        "-c",
                        "cat > /etc/fail2ban/jail.local <<'EOF'\n[DEFAULT]\nbantime = 1h\nfindtime = 10m\nmaxretry = 5\nbanaction = nftables-multiport\n\n[sshd]\nenabled = true\nport = ssh\nbackend = systemd\nEOF"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        }
    }
}
