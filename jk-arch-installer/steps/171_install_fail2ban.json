{
    "id": "install_fail2ban",
    "variants": {
        "install_only": {
            "id": "install_fail2ban_only",
            "name": {
                "de": "Fail2Ban installieren",
                "en": "Install Fail2Ban"
            },
            "description": {
                "de": "Installiert Fail2Ban ohne zusätzliche Konfiguration und ohne den Dienst automatisch zu aktivieren.",
                "en": "Installs Fail2Ban without additional configuration or automatically enabling the service."
            },
            "question": {
                "de": "Soll Fail2Ban lediglich installiert werden?",
                "en": "Should Fail2Ban only be installed?"
            },
            "optional": true,
            "exclusive_group": "fail2ban_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban ohne zusätzliche Konfiguration.",
                        "en": "Installs Fail2Ban without additional configuration."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "with_config": {
            "id": "install_fail2ban_with_config",
            "name": {
                "de": "Fail2Ban installieren und konfigurieren",
                "en": "Install and configure Fail2Ban"
            },
            "description": {
                "de": "Installiert Fail2Ban, erstellt eine SSH-Schutzkonfiguration, aktiviert den Dienst und überprüft das SSH-Jail.",
                "en": "Installs Fail2Ban, creates an SSH protection configuration, enables the service and checks the SSH jail."
            },
            "question": {
                "de": "Soll Fail2Ban vollständig installiert, für SSH konfiguriert und aktiviert werden?",
                "en": "Should Fail2Ban be fully installed, configured for SSH and enabled?"
            },
            "optional": true,
            "exclusive_group": "fail2ban_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Erstellt die lokale Fail2Ban-Konfiguration für SSH.",
                        "en": "Creates the local Fail2Ban configuration for SSH."
                    },
                    "command": [
                        "sh",
                        "-c",
                        "cat > /etc/fail2ban/jail.local <<'EOF'\n[DEFAULT]\nbantime = 1h\nfindtime = 10m\nmaxretry = 5\nbanaction = nftables-multiport\n\n[sshd]\nenabled = true\nport = ssh\nbackend = systemd\nEOF"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert und startet Fail2Ban.",
                        "en": "Enables and starts Fail2Ban."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "fail2ban.service"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Überprüft den Status des SSH-Jails.",
                        "en": "Checks the status of the SSH jail."
                    },
                    "command": [
                        "fail2ban-client",
                        "status",
                        "sshd"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "install_only_enable": {
            "id": "install_fail2ban_enable",
            "name": {
                "de": "Fail2Ban installieren und aktivieren",
                "en": "Install and enable Fail2Ban"
            },
            "description": {
                "de": "Installiert Fail2Ban und aktiviert den Dienst dauerhaft, ohne eine zusätzliche Konfiguration zu erstellen.",
                "en": "Installs Fail2Ban and permanently enables the service without creating additional configuration."
            },
            "question": {
                "de": "Soll Fail2Ban installiert und sofort aktiviert werden, ohne zusätzliche Konfiguration?",
                "en": "Should Fail2Ban be installed and enabled immediately without additional configuration?"
            },
            "optional": true,
            "exclusive_group": "fail2ban_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Aktiviert und startet Fail2Ban ohne zusätzliche Konfiguration.",
                        "en": "Enables and starts Fail2Ban without additional configuration."
                    },
                    "command": [
                        "systemctl",
                        "enable",
                        "--now",
                        "fail2ban.service"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        },
        "with_config_no_enable": {
            "id": "install_fail2ban_config_no_enable",
            "name": {
                "de": "Fail2Ban installieren und konfigurieren, aber nicht aktivieren",
                "en": "Install and configure Fail2Ban without enabling"
            },
            "description": {
                "de": "Installiert Fail2Ban und erstellt eine SSH-Schutzkonfiguration, aktiviert den Dienst jedoch nicht automatisch.",
                "en": "Installs Fail2Ban and creates an SSH protection configuration without automatically enabling the service."
            },
            "question": {
                "de": "Soll Fail2Ban installiert und für SSH konfiguriert, aber noch nicht aktiviert werden?",
                "en": "Should Fail2Ban be installed and configured for SSH, but not enabled yet?"
            },
            "optional": true,
            "exclusive_group": "fail2ban_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert Fail2Ban.",
                        "en": "Installs Fail2Ban."
                    },
                    "command": [
                        "pacman",
                        "-S",
                        "--needed",
                        "--noconfirm",
                        "fail2ban"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                },
                {
                    "description": {
                        "de": "Erstellt die lokale Fail2Ban-Konfiguration für SSH.",
                        "en": "Creates the local Fail2Ban configuration for SSH."
                    },
                    "command": [
                        "sh",
                        "-c",
                        "cat > /etc/fail2ban/jail.local <<'EOF'\n[DEFAULT]\nbantime = 1h\nfindtime = 10m\nmaxretry = 5\nbanaction = nftables-multiport\n\n[sshd]\nenabled = true\nport = ssh\nbackend = systemd\nEOF"
                    ],
                    "requires_root": true,
                    "distros": [
                        "arch",
                        "cachyos"
                    ]
                }
            ]
        }
    }
}
