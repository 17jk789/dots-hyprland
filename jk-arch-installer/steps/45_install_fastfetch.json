{
    "id": "install_fastfetch",

    "name": {
        "de": "Fastfetch installieren",
        "en": "Install Fastfetch"
    },

    "description": {
        "de": "Installiert Fastfetch zur Anzeige wichtiger Systeminformationen direkt im Terminal.",
        "en": "Installs Fastfetch for displaying important system information directly in the terminal."
    },

    "question": {
        "de": "Soll Fastfetch installiert werden?",
        "en": "Should Fastfetch be installed?"
    },

    "optional": false,

    "continue_on_error": false,

    "checks": [],

    "commands": [
        {
            "description": {
                "de": "Installiert Fastfetch über Pacman.",
                "en": "Installs Fastfetch using Pacman."
            },

            "command": [
                "pacman",
                "-S",
                "--needed",
                "--noconfirm",
                "fastfetch"
            ],

            "requires_root": true,

            "distros": [
                "arch_based"
            ]
        }
    ]
}
