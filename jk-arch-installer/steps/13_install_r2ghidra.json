{
    "id": "install_r2ghidra",
    "variants": {
        "pacman": {
            "id": "install_r2ghidra_pacman",
            "name": {
                "de": "r2ghidra über Pacman installieren",
                "en": "Install r2ghidra with Pacman"
            },
            "description": {
                "de": "Installiert radare2 und r2ghidra über die offiziellen Arch-Pakete.",
                "en": "Installs radare2 and r2ghidra from the official Arch packages."
            },
            "question": {
                "de": "Sollen radare2 und das r2ghidra-Decompilation-Plugin installiert werden?",
                "en": "Do you want to install radare2 and the r2ghidra decompilation plugin?"
            },
            "optional": true,
            "exclusive_group": "r2ghidra_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert radare2 und das r2ghidra-Decompilation-Plugin.",
                        "en": "Installs radare2 and the r2ghidra decompilation plugin."
                    },
                    "command": ["pacman", "-S", "--needed", "--noconfirm", "radare2", "r2ghidra"],
                    "requires_root": true,
                    "distros": ["arch_based"]
                },
                {
                    "description": {
                        "de": "Installiert die optionalen Python-Bindings für r2pipe.",
                        "en": "Installs the optional Python bindings for r2pipe."
                    },
                    "command": ["pacman", "-S", "--needed", "--noconfirm", "python-r2pipe"],
                    "requires_root": true,
                    "distros": ["arch_based"]
                }
            ]
        },
        "r2pm": {
            "id": "install_r2ghidra_r2pm",
            "name": {
                "de": "r2ghidra über r2pm installieren",
                "en": "Install r2ghidra with r2pm"
            },
            "description": {
                "de": "Installiert r2ghidra alternativ über den radare2 Package Manager r2pm.",
                "en": "Installs r2ghidra alternatively through radare2's package manager r2pm."
            },
            "question": {
                "de": "Soll r2ghidra über r2pm installiert werden?",
                "en": "Do you want to install r2ghidra through r2pm?"
            },
            "optional": true,
            "exclusive_group": "r2ghidra_method",
            "continue_on_error": false,
            "checks": [],
            "commands": [
                {
                    "description": {
                        "de": "Installiert radare2 als Voraussetzung für r2pm.",
                        "en": "Installs radare2 as a prerequisite for r2pm."
                    },
                    "command": ["pacman", "-S", "--needed", "--noconfirm", "radare2"],
                    "requires_root": true,
                    "distros": ["arch_based"]
                },
                {
                    "description": {
                        "de": "Aktualisiert r2pm.",
                        "en": "Updates r2pm."
                    },
                    "command": ["r2pm", "-U"],
                    "requires_root": false,
                    "distros": ["arch_based"]
                },
                {
                    "description": {
                        "de": "Initialisiert r2pm.",
                        "en": "Initializes r2pm."
                    },
                    "command": ["r2pm", "-init"],
                    "requires_root": false,
                    "distros": ["arch_based"]
                },
                {
                    "description": {
                        "de": "Installiert das r2ghidra-Plugin über r2pm.",
                        "en": "Installs the r2ghidra plugin through r2pm."
                    },
                    "command": ["r2pm", "-i", "r2ghidra"],
                    "requires_root": false,
                    "distros": ["arch_based"]
                }
            ]
        }
    }
}
